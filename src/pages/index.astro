---
import Base from '../layouts/Base.astro';
import Link from '../components/Link.astro';
import WorkList from '../components/WorkList.astro';
import { work } from '../data/work';
---

<Base title="Chase Durrett" description="Chase Durrett — full-stack developer based in Oklahoma City.">
	<header class="intro">
		<p class="name reveal" style="--i: 0">Chase Durrett</p>
		<p class="meta reveal" style="--i: 1">@donutboyband</p>
	</header>

	<section class="bio">
		<p class="reveal" style="--i: 2">
			I&rsquo;m a full-stack developer based in Oklahoma City, working remotely.
		</p>

		<p class="reveal" style="--i: 3">
			I build enterprise applications at Baltimore Life Insurance Company. Before that I worked as
			a freelance developer under <Link href="https://weeatsoup.com">Soup Agency</Link>, and before
			that I ran IT at Audigent (Experian).
		</p>

		<p class="reveal" style="--i: 4">
			On the side I&rsquo;m always tinkering and making things. I am working on{' '}
			<Link href="https://willow.fm">Willow</Link>, a peer-to-peer music marketplace for trading
			equity in your music for the work it needs. I also make music with my band
			<Link href="https://open.spotify.com/artist/4e0F3Bqyp0BpE3VmNh4qKS?si=_0xQmRUSSWu95WSv-keyng"
				>J. Pastel</Link
			>.
		</p>

		<p class="reveal" style="--i: 5">
			I care about clean code, scalable systems, and interfaces that feel good to use.
		</p>

		<p class="reveal" style="--i: 6">
			You can find me on <Link href="https://github.com/donutboyband">GitHub</Link>,
			<Link href="https://www.linkedin.com/in/chasedurrett/">LinkedIn</Link>, or reach me via
			<Link href="mailto:chase@chasedurrett.dev">email</Link>.
		</p>
	</section>

	<WorkList items={work} start={7} />
</Base>
